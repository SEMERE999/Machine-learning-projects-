    "from sklearn.svm import SVC\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.model_selection import train_test_split,GridSearchCV\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.metrics import accuracy_score,confusion_matrix\n",
    "xtrain,xtest,ytrain,ytest=train_test_split(x,y,test_size=0.2,shuffle=True,random_state=42)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 62,
   "id": "cb000f96",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Best params: {'model__C': 20, 'model__gamma': 'scale', 'model__kernel': 'rbf'}\n",
      "Best score: 0.9761904761904763\n",
      "Test score: 0.8809523809523809\n"
     ]
    }
   ],
   "source": [
    "pipe=Pipeline([('scale',StandardScaler()),('model',SVC())])\n",
    "param = {\n",
    "    'model__kernel': ['linear', 'rbf', 'poly'],\n",
    "    'model__C': [0.1, 1, 5, 10, 20, 50, 100],\n",
    "    'model__gamma': ['scale', 'auto']\n",
    "}\n",
    "\n",
    "kkk = GridSearchCV(pipe, param, cv=4, scoring='accuracy', n_jobs=-1)\n",
    "kkk.fit(xtrain, ytrain)\n",
    "\n",
    "print(\"Best params:\", kkk.best_params_)\n",
    "print(\"Best score:\", kkk.best_score_)\n",
    "print(\"Test score:\", kkk.score(xtest, ytest))\n"
   ]
  },
