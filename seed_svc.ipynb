   ],
   "source": [
    "xc=SVC(kernel='rbf',C=45,gamma='auto')\n",
    "xc.fit(xtrain,ytrain)\n",
    "prd=xc.predict(xtest)\n",
    "print(accuracy_score(ytest,prd))"
   ]
